{
  "info": {
    "name": "Event Booking API",
    "description": "Postman collection for the Event Booking REST API. Organized into three resource folders: Venues, Events, and Attendees, plus Relationship Endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "Venues",
      "item": [
        {
          "name": "Get All Venues",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/venues",
              "host": [
                "localhost"
              ],
              "path": [
                "venues"
              ],
              "protocol": "http",
              "port": "3000"
            },
            "description": "Returns a list of all venues."
          }
        },
        {
          "name": "Get Venue by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/venues/1",
              "host": [
                "localhost"
              ],
              "path": [
                "venues",
                "1"
              ],
              "protocol": "http",
              "port": "3000"
            },
            "description": "Returns a single venue by ID, including its events. Returns 404 if not found."
          }
        },
        {
          "name": "Create Venue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grand Hall\",\n  \"location\": \"123 Main Street, Manila\",\n  \"capacity\": 500,\n  \"description\": \"A large multi-purpose event hall.\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/venues",
              "host": [
                "localhost"
              ],
              "path": [
                "venues"
              ],
              "protocol": "http",
              "port": "3000"
            },
            "description": "Creates a new venue. Requires: name, location, capacity. Returns 201 on success, 400 on validation failure."
          }
        },
        {
          "name": "Update Venue",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grand Hall Updated\",\n  \"capacity\": 600\n}"
            },
            "url": {
              "raw": "http://localhost:3000/venues/1",
              "host": [
                "localhost"
              ],
              "path": [
                "venues",
                "1"
              ],
              "protocol": "http",
              "port": "3000"
            },
            "description": "Updates an existing venue by ID. Returns 404 if not found."
          }
        },
        {
          "name": "Delete Venue",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/venues/1",
              "host": [
                "localhost"
              ],
              "path": [
                "venues",
                "1"
              ],
              "protocol": "http",
              "port": "3000"
            },
            "description": "Deletes a venue by ID. Returns 404 if not found."
          }
        }
      ]
    },
