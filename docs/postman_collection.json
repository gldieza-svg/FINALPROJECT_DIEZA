    {
      "name": "Relationship Endpoints",
      "item": [
        {
          "name": "Register Attendee to Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attendeeId\": 1\n}"
            },
            "url": {
              "raw": "http://localhost:3000/events/1/register",
              "host": [
                "localhost"
              ],
              "path": [
                "events",
                "1",
                "register"
              ],
              "protocol": "http",
              "port": "3000"
            },
            "description": "Registers an attendee to a specific event (many-to-many). Returns 201 on success, 400 if already registered, 404 if event or attendee not found."
          }
        },
        {
          "name": "Unregister Attendee from Event",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attendeeId\": 1\n}"
            },
            "url": {
              "raw": "http://localhost:3000/events/1/unregister",
              "host": [
                "localhost"
              ],
              "path": [
                "events",
                "1",
                "unregister"
              ],
              "protocol": "http",
              "port": "3000"
            },
            "description": "Removes an attendee from a specific event. Returns 200 on success, 400 if not registered, 404 if not found."
          }
        },
        {
          "name": "List Attendees of an Event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/events/1/attendees",
              "host": [
                "localhost"
              ],
              "path": [
                "events",
                "1",
                "attendees"
              ],
              "protocol": "http",
              "port": "3000"
            },
            "description": "Returns all attendees registered to a specific event. Returns 404 if event not found."
          }
        }
      ]
    },
