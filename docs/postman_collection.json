              "raw": "{\n  \"title\": \"Tech Summit 2025\",\n  \"description\": \"Annual technology conference.\",\n  \"date\": \"2025-09-15\",\n  \"time\": \"09:00:00\",\n  \"price\": 150.00,\n  \"venueId\": 1\n}"
